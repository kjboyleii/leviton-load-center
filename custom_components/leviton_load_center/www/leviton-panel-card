/**
 * Leviton breaker panel card.
 *
 * Layout model (matches sensor_descriptions._is_on_leg):
 *   - Positions are numbered by row: row r holds positions 2r-1 (left) and 2r (right).
 *   - A 2-pole breaker at position p spans positions p and p+2 (two rows, same column).
 *
 * Card config:
 *   type: custom:leviton-panel-card
 *   hub: <hub id>     # optional; defaults to the first hub found
 *   title: <string>   # optional; defaults to the hub name
 */
class LevitonPanelCard extends HTMLElement {
  constructor() {
    super();
    this.attachShadow({ mode: "open" });
    this._layouts = null;
    this._error = null;
    this._unsub = null;
    this._subscribing = false;
  }

  setConfig(config) {
    this._config = config || {};
    this._render();
  }

  set hass(hass) {
    this._hass = hass;
    this._subscribe();
  }

  connectedCallback() {
    this._subscribe();
  }

  disconnectedCallback() {
    if (this._unsub) {
      this._unsub();
      this._unsub = null;
    }
  }

  getCardSize() {
    const layout = this._pickLayout();
    return layout ? Math.ceil(layout.size / 2) * 1.2 + 2 : 8;
  }

  static getStubConfig() {
    return {};
  }

  async _subscribe() {
    if (this._unsub || this._subscribing || !this._hass || !this.isConnected) return;
    this._subscribing = true;
    try {
      this._unsub = await this._hass.connection.subscribeMessage(
        (layouts) => {
          this._layouts = layouts;
          this._error = null;
          this._render();
        },
        { type: "leviton_load_center/subscribe_panel_layout" }
      );
    } catch (err) {
      this._error = err && err.message ? err.message : String(err);
      this._render();
    } finally {
      this._subscribing = false;
    }
  }

  _pickLayout() {
    if (!this._layouts || !this._layouts.length) return null;
    const hub = this._config && this._config.hub;
    return (hub && this._layouts.find((l) => l.hub_id === hub)) || this._layouts[0];
  }

  _render() {
    const layout = this._pickLayout();
    let body;

    if (this._error) {
      body = `<div class="note">Could not load panel layout: ${esc(this._error)}</div>`;
    } else if (!this._layouts) {
      body = `<div class="note">Loading panel…</div>`;
    } else if (!layout) {
      body = `<div class="note">No Leviton hubs found. Check that the integration is set up.</div>`;
    } else {
      body = this._panelHtml(layout);
    }

    const title =
      (this._config && this._config.title) || (layout && layout.name) || "Breaker panel";

    this.shadowRoot.innerHTML = `
      <style>${STYLE}</style>
      <ha-card>
        <div class="header">${esc(title)}</div>
        ${body}
      </ha-card>`;
  }

  _panelHtml(layout) {
    const rows = layout.size / 2;
    const occupied = new Set();
    const cells = [];

    for (const b of layout.breakers) {
      const left = b.position % 2 === 1;
      const row = Math.ceil(b.position / 2);
      const span = Math.max(1, b.poles);
      for (let i = 0; i < span; i++) occupied.add(b.position + 2 * i);
      cells.push(this._breakerHtml(b, row, span, left));
    }

    for (let r = 1; r <= rows; r++) {
      const l = 2 * r - 1;
      const rt = 2 * r;
      cells.push(
        `<div class="spine" style="grid-row:${r};grid-column:3"><span>${l}</span><span>${rt}</span></div>`
      );
      if (!occupied.has(l))
        cells.push(`<div class="empty" style="grid-row:${r};grid-column:2"></div>`);
      if (!occupied.has(rt))
        cells.push(`<div class="empty" style="grid-row:${r};grid-column:4"></div>`);
    }

    return `
      <div class="enclosure">
        <div class="grid" style="grid-template-rows:repeat(${rows}, var(--row-h))">
          ${cells.join("")}
        </div>
      </div>`;
  }

  _breakerHtml(b, row, span, left) {
    const side = left ? "left" : "right";
    const faceCol = left ? 2 : 4;
    const labelCol = left ? 1 : 5;
    const end = b.position + 2 * (span - 1);
    const tip = `Position ${b.position}${span > 1 ? "–" + end : ""}`;
    const name = b.name
      ? `<span class="nm">${esc(b.name)}</span>`
      : `<span class="nm unnamed">Position ${b.position}</span>`;

    // Fixed slots, nearest the switch first: AF, GF, OFF. A breaker without a given
    // light keeps its (hidden) slot so the lights line up down the whole panel.
    const present = b.indicators || [];
    const lit = b.lit || [];
    const leds = ["af", "gf", "off"]
      .map((k) => {
        const cls = [k, present.includes(k) ? "" : "absent", lit.includes(k) ? "on" : ""]
          .filter(Boolean)
          .join(" ");
        return `<div class="lt${present.includes(k) ? "" : " absent"}"><i class="led ${cls}"></i><b>${k.toUpperCase()}</b></div>`;
      })
      .join("");

    const face = `
      <div class="face ${side}${span > 1 ? " double" : ""}" style="grid-row:${row} / span ${span};grid-column:${faceCol}" title="${esc(tip)}">
        <div class="fc">
          <div class="sw"><span class="t">OFF</span><span class="win ${esc(b.window || "off")}"></span><span class="t">ON</span></div>
          <div class="amp">${b.rating ? esc(b.rating) : ""}</div>
          <div class="ind">${leds}</div>
        </div>
      </div>`;

    const label = `<div class="label ${side}" style="grid-row:${row} / span ${span};grid-column:${labelCol}" title="${esc(tip)}">${name}</div>`;
    return face + label;
  }
}

function esc(s) {
  return String(s).replace(/[&<>"']/g, (c) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
  }[c]));
}

const STYLE = `
  :host {
    --row-h: 56px;
    --face-w: 176px;
    --metal: var(--secondary-background-color, #e4e6e8);
    --metal-edge: var(--divider-color, #b8bcc0);
    --ink: var(--primary-text-color, #1c1c1c);
    --ink-dim: var(--secondary-text-color, #6b6f73);
  }
  .header { padding: 16px 16px 4px; font-size: 1.1rem; font-weight: 500; color: var(--ink); }
  .note { padding: 16px; color: var(--ink-dim); }
  .enclosure {
    margin: 12px 16px 16px; padding: 12px;
    background: var(--metal); border: 2px solid var(--metal-edge); border-radius: 6px;
  }
  .grid {
    display: grid; row-gap: 4px;
    grid-template-columns: minmax(0, 1fr) var(--face-w) 26px var(--face-w) minmax(0, 1fr);
  }
  .spine {
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    font-size: .62rem; line-height: 1.1; color: var(--ink-dim); font-variant-numeric: tabular-nums;
  }
  .empty { border: 1px dashed var(--metal-edge); border-radius: 3px; opacity: .6; }

  .label { display: flex; align-items: center; min-width: 0; padding: 0 8px; }
  .label.left { justify-content: flex-end; text-align: right; }
  .label.right { justify-content: flex-start; text-align: left; }
  .nm { color: var(--ink); font-size: .85rem; font-weight: 500;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nm.unnamed { color: var(--ink-dim); font-weight: 400; }

  /* Breaker face: physical white plastic, so fixed colors regardless of theme. */
  .face {
    display: flex; flex-direction: column; justify-content: center;
    background: #f4f4f1; border: 1px solid #b9b9b3; border-radius: 3px; color: #3a3a37;
    overflow: hidden;
  }
  .fc { display: flex; align-items: center; gap: 10px; padding: 0 10px; height: 100%; }
  /* Top of the face points to the middle of the panel. DOM order is top to bottom:
     switch, rating, indicators. */
  .face.left  .fc { flex-direction: row-reverse; }
  .face.right .fc { flex-direction: row; }

  /* 2-pole: the switch block is one pole wide and sits on the right half of the
     face as photographed. Rotated so the top faces the panel middle, that half is
     the lower row in the left column and the upper row in the right column. */
  .face.double .fc { height: var(--row-h); flex: none; }
  .face.double.left  { justify-content: flex-end; }
  .face.double.right { justify-content: flex-start; }

  .sw {
    display: flex; align-items: center; gap: 4px; align-self: stretch; margin: 7px 0;
    padding: 0 5px; background: #ebebe7; border: 1px solid #c4c4be; border-radius: 3px;
    font-size: .56rem; font-weight: 600; letter-spacing: .02em;
  }
  .face.left .sw { flex-direction: row-reverse; }
  .win { flex: none; width: 5px; height: 16px; border-radius: 1px; border: 1px solid #9a9a94; background: #fff; }
  .win.on { background: #2f9e44; border-color: #2b8a3e; }
  .win.tripped { background: #e03131; border-color: #c92a2a; }
  .win.off { background: #fff; }
  .win.none { background: #b4b4ae; border-color: #9a9a94; }

  .amp { flex: 1; text-align: center; font-size: 1rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  /* Indicators run horizontally: AF nearest the switch, OFF farthest. DOM order is
     AF, GF, OFF, and the face direction mirrors it for the left column. */
  .ind { flex: none; display: flex; flex-direction: row; gap: 3px; }
  .face.left .ind { flex-direction: row-reverse; }
  .lt { width: 20px; display: flex; flex-direction: column; align-items: center; gap: 3px;
        font-size: .56rem; font-weight: 700; line-height: 1; }
  .lt.absent { visibility: hidden; }
  .led { display: block; width: 8px; height: 8px; border-radius: 1px; background: #2b2b29; }
  .led.on { background: #f08c00; } /* every lit indicator is amber */
`;

customElements.define("leviton-panel-card", LevitonPanelCard);
window.customCards = window.customCards || [];
window.customCards.push({
  type: "leviton-panel-card",
  name: "Leviton breaker panel",
  description: "Physical-style layout of a Leviton panel with breaker faces, positions and labels.",
});
